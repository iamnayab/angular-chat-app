# Server Configuration
PORT=3000
NODE_ENV=development

# 4-digit Room Authorization (SHA-256 hash of "0202")
ROOM_HASH=3472adbbcb9677d1b45365d37d96d1c33217d745567577fd9bd5c2766a258320

# PostgreSQL Database URL (Render / Supabase / Neon / Local)
# If left blank, automatically falls back to local JSON store (chat_data.json)
DATABASE_URL=

# Website URL for push notification click-action
WEBSITE_URL=http://localhost:4200

# Firebase Admin SDK Configuration (Optional - for Android Push Alerts)
# Option 1: Path to service account file
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option 2: JSON string in environment variable
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Option 3: Individual env variables
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
